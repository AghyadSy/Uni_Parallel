          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Postman Product\",\"sku\":\"POSTMAN-001\",\"price\":\"19.99\",\"stock\":10,\"is_popular\":true}"
            },
            "url": "{{baseUrl}}/api/products/"
          }
        },
